# Arc Wellness — Apache rules for GoDaddy cPanel
# Extract zip contents into: public_html/arcwellness.net
# Addon domain document root → https://arcwellness.net
#
# Site is a Next.js static export (trailingSlash: true).
# Each route is a folder with index.html (e.g. about/index.html).

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ——— Force HTTPS + strip www → https://arcwellness.net ———
  # Covers: http://arcwellness.net, http://www., https://www.
  RewriteCond %{HTTP_HOST} ^www\.arcwellness\.net$ [NC,OR]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://arcwellness.net%{REQUEST_URI} [L,R=301]

  # GoDaddy SSL proxy fallback (some plans only set X-Forwarded-Proto)
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://arcwellness.net%{REQUEST_URI} [L,R=301]

  # ——— Legacy redirects (parity with next.config.ts) ———
  RewriteRule ^book/?$ https://booking.mangomint.com/892312 [L,R=301]
  RewriteRule ^treatments/nutrient-therapy/?$ /treatments/infusion-therapy/ [L,R=301]
  RewriteRule ^treatments/daxxify/?$ /treatments/neuromodulators/ [L,R=301]
  RewriteRule ^treatments/rha/?$ /treatments/dermal-fillers/ [L,R=301]
  RewriteRule ^case-studies/?$ /library/education/ [L,R=301]
  RewriteRule ^case-studies/(.+)/?$ /blogs/$1/ [L,R=301]
  RewriteRule ^blog/insulin-resistance-signs-symptoms/?$ /blogs/insulin-resistance-signs-symptoms/ [L,R=301]
  RewriteRule ^blogs/could-it-be-insulin-resistance/?$ /blogs/insulin-resistance-signs-symptoms/ [L,R=301]
  RewriteRule ^case-studies/could-it-be-insulin-resistance/?$ /blogs/insulin-resistance-signs-symptoms/ [L,R=301]
  RewriteRule ^blogs/hormones-through-the-decades/?$ /blogs/hormones-through-the-decades-st-louis-mo/ [L,R=301]
  RewriteRule ^blog/hormones-through-the-decades/?$ /blogs/hormones-through-the-decades-st-louis-mo/ [L,R=301]
  RewriteRule ^case-studies/hormones-through-the-decades/?$ /blogs/hormones-through-the-decades-st-louis-mo/ [L,R=301]
  RewriteRule ^blogs/how-hormones-change-with-age/?$ /blogs/hormones-through-the-decades-st-louis-mo/ [L,R=301]
  RewriteRule ^blog/how-hormones-change-with-age/?$ /blogs/hormones-through-the-decades-st-louis-mo/ [L,R=301]
  RewriteRule ^blogs/inflammation-your-bodys-built-in-alarm-system/?$ /blogs/understanding-chronic-inflammation/ [L,R=301]

  # ——— Trailing slash for exported folders ( /about → /about/ ) ———
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ /$1/ [L,R=301]

  # ——— Map clean URLs to exported HTML ———
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>

# ——— Caching ———
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2?|ttf|otf|eot|png|jpe?g|gif|webp|avif|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ——— Compression ———
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml
</IfModule>

# ——— Security headers ———
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

ErrorDocument 404 /404.html
