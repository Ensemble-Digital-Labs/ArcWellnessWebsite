# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# stray local copy (only build artifacts; real app lives at repo root)
/arc-wellness/

# ── Local dev / design tooling (not deployed to Netlify) ─────────────────────
/extraction tool/
/learning/
/local-envdev/
/scripts/
/design/
/documents/
