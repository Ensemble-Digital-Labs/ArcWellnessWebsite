/.vscode/

# Agent IDE hints (not part of the site build)
AGENTS.md
CLAUDE.md

# Client review & planning spreadsheets
*.xlsx
*.xls

# Salterra / nav experiments — not used in production site
/public/assets/branding/arc-nav-*
/public/assets/branding/salterra-*
/public/assets/branding/arc-nav-wiggle*

# Source video files — often >100MB; GitHub rejects. Keep locally, use Git LFS, or host on CDN.
/public/assets/videos/**/*.mov
# Tracked: hero + pinned micro-statement loop (~40MB; under GitHub’s 100MB file cap).
!/public/assets/videos/hero/spa-background-oriental-therapy.mov

# production
/build

# misc
.DS_Store
*.pem
debug-*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
